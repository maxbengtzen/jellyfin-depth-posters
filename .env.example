# Copy to .env and fill in. .env is git-ignored; never commit it.

# Jellyfin API key (Dashboard -> Advanced -> API Keys).
JELLYFIN_API_KEY=

# Docker network Jellyfin runs on (docker network ls). The service joins it.
JELLYFIN_NETWORK=jellyfin_default
# Jellyfin's address on that network (container name and port).
JELLYFIN_URL=http://jellyfin:8096

# small (Apache-2.0), base or large (CC-BY-NC-4.0: non-commercial use only).
DEPTH_MODEL=small
# Also cut each poster into inpainted layers (about 5x slower, nicer 3D). See docs.
ENABLE_LAYERS=false
# Longest side, in px, of the images the service works on.
MAX_SIZE=720
# Minutes between scans of the Jellyfin library.
SCAN_INTERVAL_MIN=30
# Which Jellyfin item types to process.
ITEM_TYPES=Movie,Series

# User/group the container runs as (owner of ./data and ./.cache).
PUID=1000
PGID=1000
